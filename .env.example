# ─────────────────────────────────────────────────────────────
# AceMail environment configuration
# Copy this file to .env and fill in every value:
#   cp .env.example .env
# Never commit your real .env — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Supabase (database, auth, storage) ──────────────────────
# Find these in Supabase → Project Settings → API.
# The VITE_* copies are baked into the browser bundle at build time;
# the plain copies are read by server-side code at runtime.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_PROJECT_ID=your-project-ref

# Service-role key (Supabase → Project Settings → API → service_role).
# Used only by privileged server code (queue processor, tracking routes).
# Keep it secret — it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────────────
# The public URL where your app is reachable. Used for tracking
# pixels, click links and unsubscribe links inside sent emails.
APP_URL=http://localhost:3000

# A long random string you invent. Protects the sending-queue endpoint
# (/api/public/hooks/process-queue). Your cron caller must send it as
# "Authorization: Bearer <this value>".
# Generate one with: openssl rand -hex 32
QUEUE_HOOK_SECRET=change-me-to-a-long-random-string

# A long random string (32+ chars). Encrypts stored mailbox connection
# keys and LinkedIn session cookies in the database.
# Generate one with: openssl rand -hex 32
APP_USER_CONNECTION_KEY_SECRET=change-me-to-another-long-random-string

# ── Optional: Lovable platform services ─────────────────────
# These only apply when running inside Lovable. Self-hosted installs
# can leave them unset — see README "What works differently outside Lovable".
# LOVABLE_API_KEY=
# GOOGLE_MAIL_APP_USER_CONNECTOR_CLIENT_API_KEY=
# GOOGLE_SHEETS_APP_USER_CONNECTOR_CLIENT_API_KEY=
# GOOGLE_DRIVE_APP_USER_CONNECTOR_CLIENT_API_KEY=
