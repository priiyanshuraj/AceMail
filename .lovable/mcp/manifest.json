                    "type": "string",
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "first_name": {
                    "default": "",
                    "type": "string",
                    "maxLength": 200
                  },
                  "last_name": {
                    "default": "",
                    "type": "string",
                    "maxLength": 200
                  },
                  "company": {
                    "default": "",
                    "type": "string",
                    "maxLength": 300
                  },
                  "custom_fields": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 5000
                    }
                  }
                },
                "required": [
