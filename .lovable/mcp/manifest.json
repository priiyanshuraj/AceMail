{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://owtmpwvjdcvqaukihcrq.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "acemail",
      "version": "0.1.0",
      "title": "Acemail"
    },
    "tools": [
      {
        "name": "list_contact_lists",
        "title": "List contact lists",
        "description": "List your AceMail contact lists (imported CSVs / sheets) with contact counts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_contacts",
        "title": "List contacts",
        "description": "Read contacts in a contact list, including all custom fields (CSV columns). Paginate with offset.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "list_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Contact list ID from list_contact_lists."
            },
            "limit": {
              "default": 50,
              "description": "Rows per page (max 200).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "offset": {
              "default": 0,
              "description": "Rows to skip.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "list_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "update_contact_fields",
        "title": "Update contact fields",
        "description": "Write values to contacts: set first_name/last_name/company or create/update custom fields (new columns usable as {{field}} in templates). Up to 200 contacts per call.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "updates": {
              "minItems": 1,
              "maxItems": 200,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "contact_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "fields": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 5000
                    },
                    "description": "Field name to value. Standard: first_name, last_name, company; anything else becomes a custom field."
                  }
                },
                "required": [
                  "contact_id",
                  "fields"
                ]
              }
            }
          },
          "required": [
            "updates"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
